# Which model answers: mlx | anthropic | openai
LLM_PROVIDER=mlx

# --- mlx (local, Apple Silicon) ---
MLX_BASE_URL=http://127.0.0.1:8080/v1
MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit

# --- anthropic (Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=claude-haiku-4-5-20251001

# --- openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- retrieval ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
# 0 skips the reranker: about 1 GB less memory, slightly worse ranking
USE_RERANK=1
